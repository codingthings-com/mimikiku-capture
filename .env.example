# mimikiku-capture settings. Copy to .env (gitignored) in this directory.
# Command-line flags override these; real environment variables do too.

# Mimikiku server's WebSocket (wss:// when it's behind TLS).
MIMIKIKU_WS_URL=ws://localhost:7777/listen

# Personal API token: web app → Account → API tokens. Required; treat as a secret.
MIMIKIKU_TOKEN=

# Don't save recordings to your account; the transcript stays local
# (the s hotkey and MIMIKIKU_OUTPUT still work). true/false.
# MIMIKIKU_NO_SAVE=true

# Add recordings to this existing transcript instead of starting a new one
# (the id is in the web app URL, /#/t/<id>).
# MIMIKIKU_TRANSCRIPT=

# Append the raw transcript JSON lines to this file. Off unless set.
# MIMIKIKU_OUTPUT=out/transcript.jsonl

# Directory for transcripts saved with the s hotkey.
# MIMIKIKU_SAVE_DIR=.

# Input device: a case-insensitive part of its name (see --list-devices).
# Default: the first "monitor"/"pipewire" device, then the default input.
# MIMIKIKU_DEVICE=monitor

# Start listening right away instead of waiting for the space key. true/false.
# MIMIKIKU_AUTOSTART=false

# Capture: channels (downmixed to mono), sample rate, frames per chunk, and the
# RMS level at or below which chunks are skipped.
# MIMIKIKU_CHANNELS=1
# MIMIKIKU_RATE=16000
# MIMIKIKU_CHUNK=2048
# MIMIKIKU_SILENCE_THRESHOLD=0
